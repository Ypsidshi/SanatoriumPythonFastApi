# Copy to .env and adjust. Never commit the real .env.
#
# SQL Server (default target of this project).
# Local SQL Server / SSMS:
DATABASE_URL=mssql+pyodbc://sa:Your_password123@localhost:1433/sanatorium?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Inside docker compose the host is the service name instead of localhost:
# DATABASE_URL=mssql+pyodbc://sa:Your_password123@mssql:1433/sanatorium?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Password used by the docker compose SQL Server container.
# SQL Server requires 8+ chars with upper case, lower case and a digit.
MSSQL_SA_PASSWORD=Your_password123
